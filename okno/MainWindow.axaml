<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Moja aplikacja!"
        Background="LightBlue"
        WindowState="Maximized">
    <Grid>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Plik">
                <MenuItem Header="_Zakończ" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="_Edycja"/>
            <MenuItem Header="P_omoc"/>
        </Menu>
        <Border DockPanel.Dock="Top"
                Background="#E3F2FD"
                BorderBrush="#90CAF9"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <TextBlock Text="Warsztat — Moja aplikacja!  |  AG"
                       VerticalAlignment="Center"/>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <DatePicker VerticalAlignment="Center"
                        Margin="16"/>
            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <Border BorderBrush="Black"
                        BorderThickness="2"
                        Padding="16"
                        Background="Yellow">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Warsztat"
                                   HorizontalAlignment="Center"/>
                        <Button Content="kliknij mnie"
                                HorizontalAlignment="Center"
                                Click="OnClickMeClick"/>
                        <CheckBox Content="Nie jestem robotem"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBox Width="220"
                         Watermark="Wpisz tekst..."/>
            </StackPanel>
            <Calendar Grid.Column="2"
                      VerticalAlignment="Center"
                      Margin="16"
                      Background="White"/>
        </Grid>
    </DockPanel>
        <TextBlock Text="AG"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,24,16"
                   FontSize="48"
                   FontWeight="Bold"
                   Opacity="0.35"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
